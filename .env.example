# =============================================================================
# Stylic AI — environment template (keys match app/config.py Settings)
# Copy to `.env` and fill values. Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional script-only (not in Settings): RESEND_TEST_TO for mail_sending.py
# =============================================================================

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=stylicai

# ── JWT (end users) ───────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SMTP ───────────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Resend (preferred when both set) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT_URL=

# ── Firebase (Google Sign-In) ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ── Gemini (vision / analysis) ─────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── SeedDream / KIE API key + upscale poll tuning ─────────────────────────
SEEDDREAM_API_KEY=
SEEDDREAM_MAX_RETRIES=120
SEEDDREAM_RETRY_DELAY=5

# ── Model face reference upload — KIE chain ────────────────────────────────
MODEL_FACE_REFERENCE_KIE_PRIMARY_MODEL=nano-banana-2
MODEL_FACE_REFERENCE_KIE_FALLBACK_MODEL=gpt-image-1.5-image-to-image

# ── App defaults ──────────────────────────────────────────────────────────
APP_NAME=Stylic AI
DEFAULT_CREDITS=5
DEFAULT_PLAN=free
OTP_EXPIRE_MINUTES=10

# ── Credits (per image) ─────────────────────────────────────────────────────
CREDIT_SINGLE_PHOTOSHOOT_PER_IMAGE=2
CREDIT_REGENERATE_PER_IMAGE=2
CREDIT_BACKGROUND_CHANGE_PER_IMAGE=2
CREDIT_UPSCALE_4X_PER_IMAGE=4
CREDIT_UPSCALE_8X_PER_IMAGE=8
CREDIT_BRANDING_PER_IMAGE=1
CREDIT_RESIZE_PER_IMAGE=1
CREDIT_ADJUST_IMAGE_PER_IMAGE=1
CREDIT_FABRIC_CHANGE_PER_IMAGE=3
CREDIT_TEXTURE_CHANGE_PER_IMAGE=3
CREDIT_COLOR_CHANGE_PER_IMAGE=3
CREDIT_REMOVE_BACKGROUND=1
CREDIT_USER_UPSCALE_2X=3
CREDIT_USER_UPSCALE_4X=5
CREDIT_USER_UPSCALE_8X=7

# ── fal.ai (optional remove-background fallback) ───────────────────────────
FAL_API_KEY=

# ── Modal realism + KIE upscale ───────────────────────────────────────────
MODAL_APP_NAME=fashion-realism
MODAL_CLS_PRIMARY=FashionRealismT4
MODAL_CLS_FALLBACK=FashionRealismL4
WHICH_UPSCALE=kie
KIE_UPSCALE_MODEL=topaz/image-upscale
KIE_UPSCALE_FACTOR=2
KIE_REQUEST_RETRIES=3
KIE_HTTP_TIMEOUT=300
KIE_VARIANT_FORMAT=png_fast
KIE_VARIANT_JPEG_QUALITY=95
KIE_UPSCALE_MAX_WAIT_S=900

# ── Modal KIE downsample (8K→variants on GPU) ───────────────────────────────
MODAL_KIE_DOWNSAMPLE_ENABLED=true
MODAL_KIE_DOWNSAMPLE_APP_NAME=stylic-kie-downsample
MODAL_KIE_DOWNSAMPLE_CLS=KieDownsampleT4

# ── Photoshoot LangGraph (KIE / Vertex / Evolink) ───────────────────────────
KIE_API_KEY=
KIE_GARMENT_ANALYZER_MODEL=gemini-3-pro
GOOGLE_CLOUD_API_KEY=
EVOLINK_API_KEY=
PHOTOSHOOT_GEN_ASPECT_RATIO=9:16
PHOTOSHOOT_GEN_RESOLUTION=4K
PHOTOSHOOT_GEN_PER_IMAGE_TIMEOUT_S=600
PHOTOSHOOT_KIE_POLL_INTERVAL_S=2

# ── Free-plan watermark (skips Topaz for free users) ───────────────────────
FREE_PLAN_WATERMARK_TEXT=STYLIC
FREE_PLAN_WATERMARK_OPACITY=76
FREE_PLAN_WATERMARK_ROTATION=-30
FREE_PLAN_WATERMARK_FONT_SCALE=0.09
FREE_PLAN_WATERMARK_SPACING_X_RATIO=0.28
FREE_PLAN_WATERMARK_SPACING_Y_RATIO=0.22
FREE_PLAN_WATERMARK_FONT_PATH=
FREE_PLAN_WATERMARK_FONT_URL=https://cdn.jsdelivr.net/gh/googlefonts/roboto@v2.138/src/hinted/TTF/Roboto-Regular.ttf
FREE_PLAN_WATERMARK_FONT_CACHE_DIR=
FREE_PLAN_WATERMARK_FONT_DOWNLOAD_TIMEOUT_S=45

# ── KIE rate limiter (Redis) ───────────────────────────────────────────────
KIE_RATE_LIMIT_ENABLED=true
KIE_RATE_LIMIT_MAX=10
KIE_RATE_LIMIT_WINDOW_S=10
KIE_RATE_LIMIT_KEY_PREFIX=kie:createTask
KIE_RATE_LIMIT_MAX_WAIT_S=60
KIE_RATE_LIMIT_429_SLEEP_S=5

# ── KIE feature fallback (poses / faces / backgrounds / garment edits) ─────
KIE_PRIMARY_IMAGE_MODEL=nano-banana-2
KIE_FALLBACK_IMAGE_MODEL=gpt-image-2
KIE_FEATURE_MODEL_RETRIES=3
KIE_FEATURE_ASPECT_RATIO=3:4
KIE_FEATURE_RESOLUTION=1K

# ── Razorpay ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=USD
FX_RATE_API_URL=https://api.exchangerate.host/convert
FX_RATE_TIMEOUT_S=10

# ── Redis / Celery / Flower ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
FLOWER_BASIC_AUTH=

# ── Phone parsing (optional) ────────────────────────────────────────────────
PHONE_DEFAULT_REGION=

# ── Contact-sales form rate limits ─────────────────────────────────────────
CONTACT_SALES_MAX_PER_IP=5
CONTACT_SALES_IP_WINDOW_S=3600
CONTACT_SALES_MAX_PER_EMAIL_PER_24H=5
CONTACT_SALES_TRUST_X_FORWARDED_FOR=false

# ── Email / marketing branding ────────────────────────────────────────────
STYLIC_MARKETING_BASE_URL=https://stylic.ai
STYLIC_MARKETING_LOGO_URL=
STYLIC_APP_BASE_URL=https://app.stylic.ai
STYLIC_EMAIL_BODY_BG="#0f0f12"
STYLIC_EMAIL_TEXT_PRIMARY="#e8e8ed"
STYLIC_EMAIL_FONT_STACK="'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
STYLIC_EMAIL_MAX_WIDTH="560px"
STYLIC_EMAIL_INNER_PADDING="40px 20px 48px"
STYLIC_EMAIL_LOGO_MARGIN_BOTTOM="24px"
STYLIC_EMAIL_CARD_GRADIENT="linear-gradient(180deg, #1a1a20 0%, #12121a 100%)"
STYLIC_EMAIL_CARD_BOX_SHADOW="0 24px 64px rgba(0, 0, 0, 0.4)"
STYLIC_EMAIL_CTA_GRADIENT="linear-gradient(90deg, #f7e6a0 0%, #f0b0c8 45%, #a8b8ff 100%)"
STYLIC_EMAIL_CTA_LABEL_COLOR="#0f0f12"
STYLIC_EMAIL_FOOTER_TOP_BORDER="1px solid rgba(255, 255, 255, 0.1)"
STYLIC_EMAIL_SOCIAL_INSTAGRAM_SVG=https://cdn.jsdelivr.net/npm/simple-icons@11.11.0/icons/instagram.svg
STYLIC_EMAIL_SOCIAL_FACEBOOK_SVG=https://cdn.jsdelivr.net/npm/simple-icons@11.11.0/icons/facebook.svg
STYLIC_EMAIL_SOCIAL_ICON_FILTER="brightness(0) invert(1)"
STYLIC_EMAIL_FOOTER_CONTACT=contact@stylic.ai
STYLIC_EMAIL_FOOTER_COMPANY=Aavish AI Labs
STYLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/stylicai/
STYLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/stylicai/

# ── Admin (blog CMS X-Admin-API-Key; dashboard JWT; bootstrap) ─────────────
ADMIN_API_KEY=
ADMIN_JWT_SECRET_KEY=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_BOOTSTRAP_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ── Script only (mail_sending.py; not read by Settings) ─────────────────────
RESEND_TEST_TO=
